   "source": [
    "def local_pauli_operator(L, site, pauli):\n",
    "    if pauli not in [\"X\", \"Y\", \"Z\"]:\n",
    "        raise ValueError(\"pauli must be 'X', 'Y', or 'Z'\")\n",
    " # Put the chosen Pauli on one site\n",
    " # and identity on all the others\n",
    "    label = [\"I\"] * L\n",
    "    label[site] = pauli\n",
    "    return SparsePauliOp(\"\".join(label))"
   ]
